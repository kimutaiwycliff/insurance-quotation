# Production settings for the VM (ADR-0020). deploy/bin/init-env.sh turns this into the root-only .env:
#   @DOMAIN@ and @ACME_EMAIL@ are asked for; every @secret@ / @pii_key@ becomes a fresh random value.
# Fill in the values marked "FILL IN" by hand afterwards. Never commit the resulting .env.
# Keep a copy of the finished .env in your password manager: without PII_* and RESTIC_PASSWORD, backups
# cannot be read.

# ---------------------------------------------------------------- site
ENVIRONMENT=production
LOG_LEVEL=INFO
# Base domain. Testing without a domain: <public-ip-with-dashes>.sslip.io, e.g. 129-146-10-20.sslip.io.
# The site is then https://app.<DOMAIN>; the API (callbacks only) https://api.<DOMAIN>; files https://files.<DOMAIN>.
DOMAIN=@DOMAIN@
ACME_EMAIL=@ACME_EMAIL@

# ---------------------------------------------------------------- public URLs (derived from DOMAIN)
PUBLIC_BASE_URL=https://app.@DOMAIN@
PUBLIC_API_BASE_URL=https://api.@DOMAIN@
S3_PUBLIC_ENDPOINT_URL=https://files.@DOMAIN@
CORS_ALLOWED_ORIGINS=https://app.@DOMAIN@
BETTER_AUTH_URL=https://app.@DOMAIN@
AUTH_TRUSTED_ORIGINS=https://app.@DOMAIN@
AUTH_ISSUER=https://app.@DOMAIN@

# ---------------------------------------------------------------- database (roles are created on first boot)
POSTGRES_DB=app
POSTGRES_PASSWORD=@secret@
APP_OWNER_PASSWORD=@secret@
APP_USER_PASSWORD=@secret@
APP_SCANNER_PASSWORD=@secret@
AUTH_OWNER_PASSWORD=@secret@
# Memory for Postgres. Defaults suit a 6–12 GB VM; on 24 GB use 2GB / 6GB / 6g.
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_MEM_LIMIT=2g

# ---------------------------------------------------------------- object storage (RustFS on the VM)
S3_ACCESS_KEY_ID=@secret@
S3_SECRET_ACCESS_KEY=@secret@
S3_BUCKET_DOCUMENTS=documents

# ---------------------------------------------------------------- secrets
BETTER_AUTH_SECRET=@secret@
SIGNING_SECRET=@secret@
# "key_id:base64(32 bytes)"; add new keys in front to rotate (ADR-0018). Losing these loses client PII.
PII_ENCRYPTION_KEYS=@pii_key@
PII_LOOKUP_KEY=@secret@

# ---------------------------------------------------------------- email (Brevo SMTP relay)
# Brevo → Settings → SMTP & API → SMTP: login and an SMTP key. The sender must be verified in Brevo
# (Senders, domains & dedicated IPs); until you have a domain, verify your own email address.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SECURE=false
SMTP_USERNAME=FILL-IN-brevo-smtp-login
SMTP_PASSWORD=FILL-IN-brevo-smtp-key
EMAIL_FROM_ADDRESS=FILL-IN-verified-sender@example.com
EMAIL_FROM_NAME=BrokerOS
EMAIL_FROM=BrokerOS <FILL-IN-verified-sender@example.com>

# ---------------------------------------------------------------- M-Pesa: our own subscription billing
# While testing, use the Daraja sandbox (shortcode 174379 and the sandbox keys); the simulator is refused in
# production. Go-live: docs/runbooks/mpesa-go-live.md.
PLATFORM_MPESA_ENVIRONMENT=sandbox
PLATFORM_MPESA_SHORTCODE=174379
PLATFORM_MPESA_SHORTCODE_TYPE=paybill
PLATFORM_MPESA_TILL_NUMBER=
PLATFORM_MPESA_CONSUMER_KEY=FILL-IN
PLATFORM_MPESA_CONSUMER_SECRET=FILL-IN
PLATFORM_MPESA_PASSKEY=FILL-IN
PLATFORM_MPESA_CALLBACK_SECRET=@secret@
# Safaricom's callback IPs, comma-separated, once confirmed (empty = any; the secret path still applies).
MPESA_CALLBACK_ALLOWED_IPS=

# ---------------------------------------------------------------- optional
SENTRY_DSN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MFA_ENFORCED_ROLES=

# ---------------------------------------------------------------- backups (deploy/bin/backup.sh, restic)
# Any S3-compatible bucket off the VM. Oracle Object Storage (20 GB free):
#   s3:https://<namespace>.compat.objectstorage.<region>.oraclecloud.com/<bucket>
# with a "Customer secret key" (Profile → Customer secret keys) as the access key pair.
RESTIC_REPOSITORY=FILL-IN
RESTIC_PASSWORD=@secret@
AWS_ACCESS_KEY_ID=FILL-IN
AWS_SECRET_ACCESS_KEY=FILL-IN
AWS_DEFAULT_REGION=FILL-IN-region-e.g.-af-johannesburg-1

# ---------------------------------------------------------------- monitoring (optional, free at healthchecks.io)
# Pinged after each successful backup / health check; healthchecks.io emails you when pings stop.
HEALTHCHECK_BACKUP_URL=
HEALTHCHECK_UPTIME_URL=
