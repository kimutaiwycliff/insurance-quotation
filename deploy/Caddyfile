# Caddy: automatic HTTPS for the three public hosts (ADR-0020). DOMAIN and ACME_EMAIL come from .env.
# DOMAIN can be a free wildcard-DNS name while testing (e.g. 129-146-10-20.sslip.io) and the real domain later.
{
	email {$ACME_EMAIL}
	# Empty in production. "local_certs" for rehearsals on a machine the internet cannot reach.
	{$CADDY_TLS_MODE}
}

(security) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-Via
	}
	log {
		output stdout
		format json
	}
}

# The web app (BFF): everything people use, including /api/auth and public document pages.
# /downloads/ serves the Android app's APKs from deploy/downloads on the VM (ADR-0026 amendment).
app.{$DOMAIN} {
	import security
	handle /downloads/* {
		root * /srv
		@apk path *.apk
		header @apk Content-Type "application/vnd.android.package-archive"
		header @apk Content-Disposition "attachment"
		header @apk Cache-Control "public, max-age=300"
		file_server
	}
	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}

# The API is reached directly by the Android app (every /api/v1 route needs its short-lived token, ADR-0026),
# Safaricom (M-Pesa callbacks) and unsubscribe links in emails. Docs, metrics and /internal stay closed.
api.{$DOMAIN} {
	import security
	@public path /api/v1/* /health/live
	handle @public {
		reverse_proxy api:8000
	}
	handle {
		respond "Not found" 404
	}
}

# Object storage, for presigned upload and download URLs only (the signature covers this host).
files.{$DOMAIN} {
	import security
	request_body {
		max_size 30MB
	}
	reverse_proxy storage:9000
}

# Anything else (e.g. the bare IP): nothing here.
:80 {
	respond "Not found" 404
}
