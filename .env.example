# Copy to .env for local overrides. Every variable the stack reads is documented here (spec rule §0.2.9).
# The defaults baked into compose.yaml are DEVELOPMENT-ONLY. Production secrets live in the secrets manager.

# ---- General
ENVIRONMENT=local            # local | test | staging | production
RELEASE=dev                  # image tag / git SHA; reported to logs and Sentry
LOG_LEVEL=INFO
LOG_JSON=false               # true in staging/production

# ---- Postgres (superuser only used by the init script)
POSTGRES_PASSWORD=postgres_dev
POSTGRES_DB=app
POSTGRES_PORT=55432          # host port (bound to 127.0.0.1); 55432 avoids clashing with a local Postgres
APP_OWNER_PASSWORD=app_owner_dev      # owns schema "app"; migrations only
APP_USER_PASSWORD=app_user_dev        # API + workers; subject to RLS
APP_SCANNER_PASSWORD=app_scanner_dev  # cross-tenant schedulers (narrow views only)
AUTH_OWNER_PASSWORD=auth_owner_dev    # Better Auth schema "auth"

# Composed by compose.yaml from the values above; set explicitly when running outside Compose:
# DATABASE_URL=postgresql+psycopg://app_user:app_user_dev@localhost:55432/app
# MIGRATIONS_DATABASE_URL=postgresql+psycopg://app_owner:app_owner_dev@localhost:55432/app
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---- Valkey
# VALKEY_URL=redis://localhost:6379/0

# ---- Object storage (RustFS locally; S3 or R2 in production)
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=devaccesskey
S3_SECRET_ACCESS_KEY=devsecretkey
S3_BUCKET_DOCUMENTS=documents
S3_FORCE_PATH_STYLE=true
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
# S3_ENDPOINT_URL=http://localhost:9000   # leave unset for AWS S3

# ---- HTTP
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000   # comma-separated
READINESS_TIMEOUT_SECONDS=2.0
# FORWARDED_ALLOW_IPS=10.0.0.0/8             # proxies whose X-Forwarded-* headers uvicorn trusts

# ---- Authentication (ADR-0006). Shared by the API and the auth service unless noted.
AUTH_PORT=3001                              # host port of the auth service
AUTH_ISSUER=http://localhost:3001           # "iss" of access tokens; must match on both sides
AUTH_AUDIENCE=brokeros-api                  # "aud" of access tokens
AUTH_INTERNAL_AUDIENCE=brokeros-internal    # "aud" of service tokens for /internal/* (organization hooks)
# API only:
# AUTH_JWKS_URL=http://auth:3001/api/auth/jwks   # set by compose.yaml
AUTH_ALGORITHMS=EdDSA                       # comma-separated; asymmetric algorithms only
AUTH_JWKS_CACHE_SECONDS=600
AUTH_JWKS_MIN_REFETCH_SECONDS=30            # unknown-kid refetch rate limit
AUTH_LEEWAY_SECONDS=30
MFA_ENFORCED_ROLES=                         # empty = 2FA optional; e.g. owner,accounts to require it (403 mfa_required)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MINUTE=600              # per user per tenant
RATE_LIMIT_WRITE_PER_MINUTE=120
IDEMPOTENCY_TTL_HOURS=24
# Auth service only:
BETTER_AUTH_URL=http://localhost:3000       # public URL = the web app, which proxies /api/auth/* (emails, cookies)
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef   # >= 32 chars; dev-only values refused in production
AUTH_TRUSTED_ORIGINS=http://localhost:3000  # comma-separated web origins
AUTH_RATE_LIMIT_ENABLED=true
APP_NAME=BrokerOS
EMAIL_FROM="BrokerOS <no-reply@brokeros.local>"
SMTP_HOST=mailpit                           # Mailpit locally; SES SMTP (or similar) in production
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
GOOGLE_CLIENT_ID=                           # Google sign-in is enabled only when both are set
GOOGLE_CLIENT_SECRET=
# API_INTERNAL_URL=http://api:8000          # set by compose.yaml; where hooks reach the API

# ---- Documents, PDFs, email, public links (M2)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000   # browser-reachable storage endpoint for presigned URLs
UPLOAD_MAX_BYTES=26214400                      # 25 MB
UPLOAD_URL_TTL_SECONDS=600                     # presigned PUT (<= 10 min)
DOWNLOAD_URL_TTL_SECONDS=300                   # presigned GET
# GOTENBERG_URL=http://gotenberg:3000          # set by compose.yaml (internal network only)
PDF_TIMEOUT_SECONDS=30
EMAIL_PROVIDER=smtp                            # smtp | fake
# SMTP_HOST / SMTP_PORT are shared with the auth service (above); API-only extras:
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM_ADDRESS=notifications@brokeros.local  # shared sender; agencies appear as "<Agency> via <name>"
EMAIL_FROM_NAME=BrokerOS
SIGNING_SECRET=dev-only-signing-secret-0123456789abcdef  # HMAC for unsubscribe tokens + visitor IP hashes; required in production
# The platform's own M-Pesa shortcode for subscription payments (simulator works without Safaricom; not in production)
PLATFORM_MPESA_ENVIRONMENT=simulator            # simulator | sandbox | production
PLATFORM_MPESA_SHORTCODE=174379
PLATFORM_MPESA_SHORTCODE_TYPE=paybill           # paybill | till
PLATFORM_MPESA_TILL_NUMBER=
PLATFORM_MPESA_CONSUMER_KEY=
PLATFORM_MPESA_CONSUMER_SECRET=
PLATFORM_MPESA_PASSKEY=
PLATFORM_MPESA_CALLBACK_SECRET=dev-only-platform-callback-secret   # secret path segment of the callback URL
MPESA_CALLBACK_ALLOWED_IPS=                     # Safaricom callback IPs, comma-separated (empty = any; set in production)
PUBLIC_BASE_URL=http://localhost:3000          # web origin serving /d/{token}; also the iframe frame-ancestor
PUBLIC_API_BASE_URL=http://localhost:8000      # API origin in List-Unsubscribe URLs
PUBLIC_RATE_LIMIT_PER_MINUTE=60                # per client IP on /api/v1/public/*
PUBLIC_LINK_DEFAULT_TTL_DAYS=30

# ---- Web app (W1)
WEB_PORT=3000
# AUTH_INTERNAL_URL=http://auth:3001   # set by compose.yaml: where the web app reaches the auth service
# API_INTERNAL_URL=http://api:8000     # set by compose.yaml: where the BFF reaches the API
# BETTER_AUTH_URL (above) is the web origin: the web app proxies /api/auth/* to the auth service.

# ---- Client data protection (ADR-0018)
# key_id:base64(32 random bytes), comma-separated; the first encrypts, all decrypt. Generate with:
#   python -c "import os,base64;print('k2026:'+base64.b64encode(os.urandom(32)).decode())"
PII_ENCRYPTION_KEYS=dev1:ZGV2LW9ubHktcGlpLWtleS0wMTIzNDU2Nzg5YWJjZGU=
PII_LOOKUP_KEY=dev-only-pii-lookup-key-0123456789abcdef   # >= 32 chars; HMAC for exact-match search

# ---- Observability
SENTRY_DSN=
METRICS_ENABLED=true          # /metrics must never be routed publicly

# ---- Dev tools
MAILPIT_UI_PORT=8025
