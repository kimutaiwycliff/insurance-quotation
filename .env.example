# Copy to .env for local overrides. Every variable the stack reads is documented here (spec rule §0.2.9).
# The defaults baked into compose.yaml are DEVELOPMENT-ONLY. Production secrets live in the secrets manager.

# ---- General
ENVIRONMENT=local            # local | test | staging | production
RELEASE=dev                  # image tag / git SHA; reported to logs and Sentry
LOG_LEVEL=INFO
LOG_JSON=false               # true in staging/production

# ---- Postgres (superuser only used by the init script)
POSTGRES_PASSWORD=postgres_dev
POSTGRES_DB=app
POSTGRES_PORT=55432          # host port (bound to 127.0.0.1); 55432 avoids clashing with a local Postgres
APP_OWNER_PASSWORD=app_owner_dev      # owns schema "app"; migrations only
APP_USER_PASSWORD=app_user_dev        # API + workers; subject to RLS
APP_SCANNER_PASSWORD=app_scanner_dev  # cross-tenant schedulers (narrow views only)
AUTH_OWNER_PASSWORD=auth_owner_dev    # Better Auth schema "auth"

# Composed by compose.yaml from the values above; set explicitly when running outside Compose:
# DATABASE_URL=postgresql+psycopg://app_user:app_user_dev@localhost:55432/app
# MIGRATIONS_DATABASE_URL=postgresql+psycopg://app_owner:app_owner_dev@localhost:55432/app
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---- Valkey
# VALKEY_URL=redis://localhost:6379/0

# ---- Object storage (RustFS locally; S3 or R2 in production)
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=devaccesskey
S3_SECRET_ACCESS_KEY=devsecretkey
S3_BUCKET_DOCUMENTS=documents
S3_FORCE_PATH_STYLE=true
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
# S3_ENDPOINT_URL=http://localhost:9000   # leave unset for AWS S3

# ---- HTTP
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000   # comma-separated
READINESS_TIMEOUT_SECONDS=2.0
# FORWARDED_ALLOW_IPS=10.0.0.0/8             # proxies whose X-Forwarded-* headers uvicorn trusts

# ---- Observability
SENTRY_DSN=
METRICS_ENABLED=true          # /metrics must never be routed publicly

# ---- Dev tools
MAILPIT_UI_PORT=8025
