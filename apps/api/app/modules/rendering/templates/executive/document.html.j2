{% extends "_base.html.j2" %}
{% import "_blocks.html.j2" as b %}
{% block style %}
h1, h2, .h3, .serif { font-weight: 600; }
.top { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px;
  padding-bottom: 14px; border-bottom: 1px solid var(--accent); }
.top .logo { margin: 0 auto; }
.top h1 { font-size: 26pt; color: var(--primary); letter-spacing: 1px; }
body.logo-start .top { align-items: flex-start; text-align: left; }
body.logo-start .top .logo { margin: 0; }
body.logo-end .top { flex-direction: column; align-items: flex-end; text-align: right; }
body.logo-end .top .logo { margin: 0 0 0 auto; }
.meta-row { display: flex; justify-content: space-between; gap: 24px; margin: 18px 0; }
.meta-row > * { flex: 1; }
.lines thead th { border-bottom: 1px solid var(--primary); font-family: var(--font-display); }
.lines td { border-bottom: 1px dotted var(--rule); }
.due { margin: 18px 0 0 auto; width: 46%; text-align: right; border: 1px solid var(--accent); padding: 10px 14px; }
.due .amount { font-family: var(--font-display); font-size: 18pt; color: var(--primary); }
.h3 { font-size: 11pt; color: var(--primary); margin-bottom: 4px; }
{% endblock %}
{% block body %}
<header class="top">
  <div class="brand-slot">{{ b.brandmark(doc, brand) }}</div>
  <h1>{{ title }}</h1>
</header>
<div class="meta-row">{{ b.party(doc.seller, "From") }}{{ b.party(doc.buyer, "Prepared for") }}<div>{{ b.meta(doc) }}</div></div>
{{ b.details(doc) }}
{% if doc.options %}
<div class="block">{{ b.options(doc) }}</div>
{% else %}
<div class="block">{{ b.lines(doc) }}</div>
{{ b.totals_table(doc) }}
{% endif %}
{% if doc.totals %}
<div class="due">
  <div class="muted small">{{ b.amount_due_label(doc) }}</div>
  <div class="amount">{{ b.amount_due(doc) }}</div>
</div>
{% endif %}
{% if opts.show_payment %}{{ b.payment(doc) }}{% endif %}
{% if opts.show_signature %}{{ b.signature() }}{% endif %}
{{ b.closing(doc, brand) }}
{% endblock %}
