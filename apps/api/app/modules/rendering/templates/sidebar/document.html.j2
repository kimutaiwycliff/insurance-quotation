{% extends "_base.html.j2" %}
{% import "_blocks.html.j2" as b %}
{% block style %}
.layout { display: grid; grid-template-columns: 31% 1fr; gap: 22px; }
.side { background: var(--primary); color: var(--on-primary); border-radius: 8px; padding: 20px 16px; min-height: 245mm; }
.side .logo { background: #fff; padding: 8px; border-radius: 6px; margin-bottom: 14px; }
.side .agency-name { font-size: 14pt; margin-bottom: 14px; }
.side section { margin-bottom: 18px; }
.side .muted, .side .kv dt { color: inherit; opacity: .75; }
.side .kv { grid-template-columns: 1fr; gap: 0; }
.side .kv dd { margin-bottom: 6px; font-weight: 600; }
body.logo-center .side { text-align: center; }
body.logo-center .side .logo { margin-left: auto; margin-right: auto; }
body.logo-end .side { text-align: right; }
body.logo-end .side .logo { margin-left: auto; }
.content h1 { font-size: 30pt; color: var(--primary); margin: 4px 0 2px; }
.content .bar { width: 56px; height: 5px; background: var(--accent); border-radius: 3px; margin-bottom: 18px; }
.content .block:first-of-type { margin-top: 0; }
.lines thead th { border-bottom: 2px solid var(--primary); color: var(--primary); }
.lines td { border-bottom: 1px solid var(--rule); }
.totals .grand td { border-top: 0; background: var(--accent); color: var(--on-accent); border-radius: 0; }
.h3 { font-size: 10pt; color: var(--primary); margin-bottom: 4px; }
{% endblock %}
{% block body %}
<div class="layout">
  <aside class="side">
    {{ b.brandmark(doc, brand) }}
    {{ b.party(doc.seller, "From") }}
    {{ b.party(doc.buyer, "To") }}
    <section aria-label="Document details">{{ b.meta(doc) }}</section>
  </aside>
  <div class="content">
    <h1>{{ title }}</h1>
    <div class="bar"></div>
    {{ b.main(doc, brand, opts) }}
  </div>
</div>
{% endblock %}
