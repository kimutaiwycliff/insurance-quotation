{% extends "_base.html.j2" %}
{% import "_blocks.html.j2" as b %}
{% block style %}
.band { background: var(--primary); color: var(--on-primary); padding: 18px 20px; border-radius: 6px;
  display: flex; justify-content: space-between; align-items: center; }
.band .logo { background: #fff; padding: 6px; border-radius: 4px; }
.band h1 { font-size: 24pt; letter-spacing: .5px; }
.band .kv dt { color: inherit; opacity: .8; }
.accent { height: 4px; background: var(--accent); margin: 10px 0 16px; border-radius: 2px; width: 30%; }
.parties { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.parties section { background: var(--wash); padding: 10px 12px; border-left: 4px solid var(--accent); border-radius: 4px; }
.lines thead th { background: var(--primary); color: var(--on-primary); }
.lines tbody tr:nth-child(even) td { background: var(--wash); }
.totals .grand td { border-top: 0; background: var(--primary); color: var(--on-primary); }
.h3 { font-size: 10pt; text-transform: uppercase; letter-spacing: 1px; color: var(--primary); margin-bottom: 4px; }
{% endblock %}
{% block body %}
<header class="band">
  <div>
    {% if brand.logo_data_uri %}<img class="logo" src="{{ brand.logo_data_uri }}" alt="{{ doc.seller.name }} logo">{% endif %}
    <h1>{{ title }}</h1>
  </div>
  <div>{{ b.meta(doc) }}</div>
</header>
<div class="accent"></div>
<div class="parties">{{ b.party(doc.seller, "From") }}{{ b.party(doc.buyer, "Billed to") }}</div>
{{ b.details(doc) }}
<div class="block">{{ b.lines(doc) }}</div>
{{ b.totals(doc) }}
{{ b.payment(doc) }}
{{ b.closing(doc, brand) }}
{% endblock %}
