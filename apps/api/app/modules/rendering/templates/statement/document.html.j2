{% extends "_base.html.j2" %}
{% import "_blocks.html.j2" as b %}
{% block style %}
.mast { padding-bottom: 6px; }
.mast .brand-slot { margin-bottom: 18px; }
.agency-name { font-size: 12pt; }
.hero { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; }
.hero h1 { font-size: 46pt; line-height: 1; color: var(--primary); font-weight: 800; letter-spacing: -1px; }
.hero .number { color: var(--muted); margin-top: 6px; }
.hero .due { text-align: right; }
.hero .due .label { color: var(--muted); }
.hero .due .amount { font-family: var(--font-display); font-weight: 800; font-size: 24pt; color: var(--primary); }
.bar { height: 8px; background: var(--accent); margin: 16px 0 20px; }
body.logo-center .mast .brand-slot { text-align: center; }
body.logo-center .mast .logo { margin: 0 auto; }
body.logo-end .mast .brand-slot { text-align: right; }
body.logo-end .mast .logo { margin-left: auto; }
.cols { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; margin-bottom: 8px; }
.lines thead th { border-bottom: 2px solid var(--primary); font-family: var(--font-display); color: var(--primary); }
.lines td { border-bottom: 1px solid var(--rule); }
.totals .grand td { border-top: 2px solid var(--primary); font-family: var(--font-display); font-size: 13pt; }
.h3 { font-size: 11pt; color: var(--primary); margin-bottom: 4px; }
{% endblock %}
{% block body %}
<header class="mast">
  <div class="brand-slot">{{ b.brandmark(doc, brand) }}</div>
  <div class="hero">
    <div><h1>{{ title }}</h1>{% if doc.number %}<div class="number">{{ doc.number }}</div>{% endif %}</div>
    {% if doc.totals %}<div class="due"><div class="label">{{ b.amount_due_label(doc) }}</div><div class="amount">{{ b.amount_due(doc) }}</div></div>{% endif %}
  </div>
</header>
<div class="bar"></div>
<div class="cols">{{ b.party(doc.seller, "From") }}{{ b.party(doc.buyer, "To") }}<div>{{ b.meta(doc) }}</div></div>
{{ b.main(doc, brand, opts) }}
{% endblock %}
