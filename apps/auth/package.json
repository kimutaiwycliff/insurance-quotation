{
  "name": "@brokeros/auth",
  "version": "0.1.0",
  "private": true,
  "description": "Authentication service (Better Auth on Hono): users, organizations, 2FA, JWT/JWKS",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1",
    "better-auth": "1.7.7",
    "hono": "^4.13",
    "nodemailer": "^10",
    "pg": "^8.23"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/nodemailer": "^8",
    "@types/pg": "^8",
    "tsx": "^4.23",
    "typescript": "^6",
    "vitest": "^5"
  },
  "packageManager": "pnpm@11.28.5"
}
